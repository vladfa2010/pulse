# ⚠️ ЕДИНСТВЕННЫЙ ИСТОЧНИК ПРАВДЫ ДЛЯ /opt/pulse/Caddyfile
# Деплой бэкенда (update-backend.sh) сам синхронизирует этот файл на сервер
# (md5-сравнение + бэкап + docker restart pulse-caddy при изменении).
# Правки руками на сервере ЗАПРЕЩЕНЫ — они будут перезаписаны следующим деплоем.
# Прецедент: инциденты 2026-09-15 и 2026-10-01 (docker-compose.yml), 2026-10-04 (Caddyfile).
#
(common) {
	root * /srv/dist
	encode gzip

	# ТЗ-188 (19.10.2026): базовые security-заголовки для всего домена —
	# защита от MIME-sniffing, clickjacking, утечки referrer, доступ к
	# camera/mic/geolocation (продукт не использует). Выставляются на Caddy
	# (единая точка): бэкенд своих заголовков безопасности не ставит.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	# ТЗ-188 Задача 1: CSP — фаза report-only (инвентаризация 20.11).
	# Собираем нарушения 3–7 дней; enforce — Задача 3 отдельным коммитом.
	# Источники из инвентаризации: telegram.org + oauth.telegram.org (Login
	# Widget), mc.yandex.ru (Metrika tag.js + хиты), плееры уроков
	# (youtube-nocookie/rutube/vkvideo/vimeo), inline-стили React.
	header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' https://telegram.org https://mc.yandex.ru; connect-src 'self' wss: https://mc.yandex.ru; font-src 'self' data:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://rutube.ru https://vkvideo.ru https://player.vimeo.com https://oauth.telegram.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

	# ТЗ-205: runtime OG для краулеров мессенджеров — курс, опубликованный после
	# последнего деплоя фронта, даёт превью без редеплоя (build-time пререндер
	# ТЗ-140 остаётся для поисковиков). Только User-Agent мессенджер-ботов;
	# Googlebot/Bingbot НЕ добавляем (у них пререндер + JS-рендеринг, двойная
	# подача = риск клоакинга). Только карточка курса — /education/paths/*
	# и вложенные пути исключены. Rewrite идёт до handle /api/* → прокси бэка.
	# Доказано тестами на живом Caddy 2.11 (изолированные контейнеры 23.11):
	# header matcher матчит ТОЛЬКО одно wildcard-значение (*бот*); multi-value
	# список ломает парсер («malformed header matcher»), regexp в /слэшах/
	# конфиг принимает, но НЕ матчит. Поэтому — один matcher на бота.
	@og_telegrambot {
		path /education/*
		# только карточка курса: пути и вложенные (/education/<slug>/lessons и глубже) исключены
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *TelegramBot*
	}
	@og_twitterbot {
		path /education/*
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *Twitterbot*
	}
	@og_fb {
		path /education/*
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *facebookexternalhit*
	}
	@og_whatsapp {
		path /education/*
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *WhatsApp*
	}
	@og_slackbot {
		path /education/*
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *Slackbot*
	}
	@og_discordbot {
		path /education/*
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *Discordbot*
	}
	@og_linkedinbot {
		path /education/*
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *LinkedInBot*
	}
	@og_vkshare {
		path /education/*
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *vkShare*
	}
	@og_viber {
		path /education/*
		not path /education /education/ /education/paths /education/paths/* /education/*/*
		header User-Agent *Viber*
	}
	rewrite @og_telegrambot /api/education/og/{http.request.uri.path.1}
	rewrite @og_twitterbot /api/education/og/{http.request.uri.path.1}
	rewrite @og_fb /api/education/og/{http.request.uri.path.1}
	rewrite @og_whatsapp /api/education/og/{http.request.uri.path.1}
	rewrite @og_slackbot /api/education/og/{http.request.uri.path.1}
	rewrite @og_discordbot /api/education/og/{http.request.uri.path.1}
	rewrite @og_linkedinbot /api/education/og/{http.request.uri.path.1}
	rewrite @og_vkshare /api/education/og/{http.request.uri.path.1}
	rewrite @og_viber /api/education/og/{http.request.uri.path.1}

	handle /api/* {
		reverse_proxy backend:3001
	}

	# ТЗ-183: MCP Streamable HTTP — внешние ИИ-клиенты (Claude Desktop, Cursor)
	# ходят на /mcp с Bearer-токеном. Без этого правила Caddy отдавал SPA-шелл
	# (200 с index.html) — MCP-клиент получал мусор вместо JSON-RPC.
	# ТЗ-187: матчим ровно /mcp и подпути — не /mcp*, чтобы не перехватывать
	# будущие SPA-маршруты вида /mcp-… (находка аудита ИБ от 2026-10-19).
	# handle не принимает список путей — через named matcher @mcp.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy backend:3001
	}

	# ТЗ-183 Задача 5: живость MCP-контура (мониторинг).
	handle /debug/mcp {
		reverse_proxy backend:3001
	}

	# ТЗ-135: кэш-политика фронта. index.html (и прочее через try_files) —
	# no-cache: Safari/браузеры обязаны ревалидировать, иначе держат СТАРЫЙ
	# HTML и старый JS-бандл после деплоя («деплой вышел, а у юзера старое»).
	# Хэшированные ассеты vite (content-hash в имени) — год, immutable.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# ТЗ-100: статика LMS (/media/*) отдаётся бэкендом (mediaGuard:
	# публичные обложки, signed URL для materials/ugc, quarantine не отдаётся).
	# Без этого правила Caddy отдавал index.html → «битые» обложки курсов.
	# Статичные ассеты фронта из public/media (tile-reveal, hero-video) —
	# отдаём напрямую из dist; динамическое /media (обложки, материалы) ниже.
	handle /media/tile-reveal/* {
		file_server
	}
	handle /media/hero-video-2.mp4 {
		file_server
	}

	handle /media/* {
		reverse_proxy backend:3001
	}

	handle /health {
		reverse_proxy backend:3001
	}

	# ТЗ-118: временный прокси legacy admin-API. УДАЛИТЬ в Задаче 3.
	# ВАЖНО: точные /admin и /admin/ — SPA-страница фронта, их НЕ проксируем.
	@adminLegacyApi {
		path /admin/* /cleanup-failed-articles
		not path /admin /admin/
	}
	handle @adminLegacyApi {
		reverse_proxy backend:3001
	}

	# ТЗ-140: try_files с {path}/index.html — build-time пререндер курсов кладёт
	# карточки в dist/education/<slug>/index.html; без {path}/index.html Caddy
	# сваливал директории в SPA-fallback /index.html и отдавал шелл вместо
	# пререндеренной страницы (проверено 2026-10-12).
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

pulse.inside-trade.ru {
	import common
}

217.114.7.184.sslip.io {
	import common
}
