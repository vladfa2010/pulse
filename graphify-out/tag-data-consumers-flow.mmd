flowchart TD
    subgraph DB["База данных"]
        UDT[("user_defined_tags<br/>is_verified + enriched_data")]
        NEWS[("news<br/>matched_tags[]")]
        PORT[("portfolios<br/>user_id ↔ tag_id")]
    end

    subgraph AdminUI["Админ UI"]
        TagCard["TagDetailModal.tsx<br/>Карточка тега<br/>редактирование + verified"]
        TagsTab["TagsTab.tsx<br/>Таблица тегов"]
        UserDetail["UserDetailModal.tsx<br/>Теги пользователя"]
        Metrics["ProductMetricsTab.tsx<br/>Статистика по тегам"]
    end

    subgraph PublicUI["Публичный UI"]
        Home["Home.tsx<br/>Облако тегов<br/>+ лимиты тарифа"]
        TagChip["Tag.tsx<br/>Пилюля тега"]
        PopTags["PopularTagsSlider.tsx<br/>Популярные теги"]
        NewsFeed["NewsFeed.tsx<br/>Лента по тегу"]
        TagEnrich["TagEnrichment.tsx<br/>Плашка обогащения"]
        NewsDetail["NewsDetailModal.tsx<br/>Обогащения тегов в новости"]
        Profile["Profile.tsx<br/>Управление тегами"]
    end

    subgraph Backend["Бэкенд-сервисы"]
        NewsProc["newsProcessor.ts<br/>Обработка новостей"]
        TagMatch["tagManager.ts / smartTagMatcher.ts<br/>Матчинг тегов"]
        Backfill["tagBackfill.ts<br/>Ретро-матчинг"]
        Enrich["enrichment.ts<br/>LLM-обогащение"]
        Digest["digest.ts<br/>Дайджест по тегам"]
        Push["push.ts<br/>Пуш-уведомления"]
        Activity["activityLog.ts<br/>Лог событий тегов"]
        Alerts["adminAlerts.ts<br/>Алерты админу"]
        Reports["reports.ts / adminMetrics.ts<br/>Отчёты и метрики"]
    end

    subgraph Notifications["Уведомления пользователям"]
        TG["Telegram bot<br/>дайджест + алерты"]
        Email["Email<br/>репорты / уведомления"]
    end

    UDT -->|"tag_name, tag_type, is_verified"| TagCard
    UDT -->|"tag_name, tag_type, is_verified<br/>articles_24h/7d/30d, subs"| TagsTab
    UDT -->|"tag_name, tag_type"| TagChip
    UDT -->|"tag_name, tag_type, popularity"| PopTags
    UDT -->|"enriched_data: ticker, website,<br/>description, sectors, trends, geo..."| TagEnrich
    UDT -->|"matched_tags[]"| NewsProc
    UDT -->|"keywords, synonyms"| TagMatch
    UDT -->|"keywords"| Backfill
    UDT -->|"все поля"| Enrich
    UDT -->|"tag_id, tag_name"| Reports

    NEWS -->|"связанные новости<br/>для карточки"| TagCard
    NEWS -->|"новости по тегу"| NewsFeed
    NEWS -->|"matched_tags[]<br/>+ обогащения"| NewsDetail

    PORT -->|"теги пользователя"| Profile
    PORT -->|"теги пользователя"| UserDetail
    PORT -->|"теги пользователя"| Digest
    PORT -->|"теги пользователя"| Push

    TagCard -->|"PUT /admin/tags/:tagId"| UDT
    TagCard -->|"POST /enrich"| Enrich
    TagCard -->|"POST /backfill-matches"| Backfill

    TagMatch -->|"заполняет"| NEWS
    Backfill -->|"заполняет"| NEWS
    Enrich -->|"обновляет"| UDT

    Digest -->|"рассылка"| TG
    Push -->|"пуши"| TG
    Reports -->|"weekly report"| Email
    Alerts -->|"алерты"| TG

    Activity -.->|"логирует"| TagCard
    Activity -.->|"логирует"| Profile
    Activity -.->|"логирует"| NewsFeed
